{
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "include": ["**/*"],
  "compilerOptions": {
    "types": ["node"],
    "lib": ["DOM", "ESNext"],
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "erasableSyntaxOnly": true
  }
}
