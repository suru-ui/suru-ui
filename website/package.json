{
  "name": "@suru-ui/website",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "run-s postinstall:*",
    "postinstall:theme": "cat \"$(node -e 'console.log(require.resolve(\"@suru-ui/theme/suru.css\"))')\" > examples/.style.css",
    "postinstall:react": "cat \"$(node -e 'console.log(require.resolve(\"@suru-ui/react/suru.css\"))')\" >> examples/.style.css",
    "postinstall:style": "cat examples/style.css >> examples/.style.css"
  },
  "dependencies": {
    "@suru-ui/react": "workspace:*",
    "@suru-ui/theme": "workspace:*",
    "blume": "^1.1.4",
    "lucide-react": "^1.27.0"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/react": "^19.2.17",
    "npm-run-all2": "^9.0.2"
  }
}
