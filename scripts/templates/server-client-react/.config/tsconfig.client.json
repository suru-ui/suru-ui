{
  "extends": ["@tsconfig/strictest"],
  "include": ["./global.d.ts", "../tests/**/*.client.test.ts", "../tests/**/*.client.test.tsx"],
  "compilerOptions": {
    "types": ["vite-plus/client", "vite-plus/test/matchers"],
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "noEmit": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "erasableSyntaxOnly": true
  }
}
