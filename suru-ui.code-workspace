{
  "folders": [
    {
      "name": ".",
      "path": "./",
    },
    {
      "name": "@suru-ui/react",
      "path": "./packages/react",
    },
    {
      "name": "@suru-ui/theme",
      "path": "./packages/theme",
    },
    {
      "name": "@suru-ui/core",
      "path": "./packages/core",
    },
    {
      "name": "@suru-ui/website",
      "path": "./website",
    },
  ],
  "settings": {
    // 一般

    "editor.rulers": [100],
    "editor.wordWrapColumn": 100,
    "editor.wordWrap": "wordWrapColumn",

    // TypeScript

    "js/ts.tsdk.path": "./node_modules/typescript/lib",

    // Oxc

    "oxc.path.node": "/home/taikun/.local/share/mise/installs/node/24/bin/node",

    "oxc.path.oxfmt": "./node_modules/.bin/oxfmt",
    "oxc.path.oxlint": "./node_modules/.bin/oxlint",
    "oxc.path.tsgolint": "./node_modules/.bin/tsgolint",

    "oxc.fmt.configPath": "./.config/.oxfmtrc.json",

    "[javascript][typescript][typescriptreact][html][markdown][json][jsonc][yaml][toml]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "always",
        "source.format.oxc": "always",
      },
      "editor.tabSize": 2,
    },
    "[mdx]": {
      "editor.tabSize": 2,
    },

    // stylelint

    "stylelint.enable": true,
    "stylelint.validate": ["css"],

    "[css]": {
      "editor.defaultFormatter": "stylelint.vscode-stylelint",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.stylelint": "always",
      },
      "editor.tabSize": 2,
    },
  },
}
