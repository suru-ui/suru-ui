{
  "name": "@suru-ui/suru",
  "version": "0.0.0",
  "license": "MIT",
  "description": "",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "dist/base.css",
    "dist/suru.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./button": {
      "types": "./dist/src/button/index.d.ts",
      "default": "./dist/src/button/index.js"
    },
    "./button/core": {
      "types": "./dist/src/button/core/index.d.ts",
      "default": "./dist/src/button/core/index.js"
    },
    "./loader": {
      "types": "./dist/src/loader/index.d.ts",
      "default": "./dist/src/loader/index.js"
    },
    "./loader/core": {
      "types": "./dist/src/loader/core/index.d.ts",
      "default": "./dist/src/loader/core/index.js"
    },
    "./select": {
      "types": "./dist/src/select/index.d.ts",
      "default": "./dist/src/select/index.js"
    },
    "./select/core": {
      "types": "./dist/src/select/core/index.d.ts",
      "default": "./dist/src/select/core/index.js"
    },
    "./text": {
      "types": "./dist/src/text/index.d.ts",
      "default": "./dist/src/text/index.js"
    },
    "./text/core": {
      "types": "./dist/src/text/core/index.d.ts",
      "default": "./dist/src/text/core/index.js"
    },
    "./text-input": {
      "types": "./dist/src/text-input/index.d.ts",
      "default": "./dist/src/text-input/index.js"
    },
    "./text-input/core": {
      "types": "./dist/src/text-input/core/index.d.ts",
      "default": "./dist/src/text-input/core/index.js"
    },
    "./scope": {
      "types": "./dist/src/scope/index.d.ts",
      "default": "./dist/src/scope/index.js"
    },
    "./theme": {
      "types": "./dist/src/theme/index.d.ts",
      "default": "./dist/src/theme/index.js"
    },
    "./base.css": "./dist/base.css",
    "./suru.css": "./dist/suru.css"
  },
  "dependencies": {
    "@suru-ui/slot": "workspace:*",
    "@suru-ui/utils": "workspace:*",
    "clsx": "^2.1.1",
    "jotai": "^2.11.3",
    "lucide-react": "^0.474.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@conform-to/react": "^1.2.2",
    "@ladle/react": "^5.0.1",
    "@suru-ui/build": "workspace:*",
    "@tailwindcss/postcss": "^4.0.3",
    "@tailwindcss/vite": "^4.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "conform-to-valibot": "^1.14.1",
    "dependency-tree": "^11.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.3",
    "valibot": "^0.42.1"
  },
  "scripts": {
    "precheck": "node --experimental-strip-types ./theme/_gen.ts",
    "check": "tsc --noEmit",
    "test": "run-s test:*",
    "test:server": "vitest -c .config/vitest.server.ts --run src/",
    "test:client": "vitest -c .config/vitest.client.ts --run src/",
    "build": "run-s build:*",
    "build:gen": "node --experimental-strip-types ./theme/_gen.ts",
    "build:src": "sui-build --outDir=dist/src",
    "build:tsc": "tsc -p .config/tsconfig.build.json",
    "build:css": "node --experimental-strip-types ./scripts/buildcss.ts",
    "build:fix": "find dist/src/ -type f -name '*.js' | xargs sed -i 's/^\\(import \".*\\.css\";\\)$/\\/\\/ \\1/'",
    "gen": "node --experimental-strip-types ./theme/_gen.ts",
    "dev": "ladle dev --config .config/ladle",
    "update": "ncu -u -x '@suru-ui/'*"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
