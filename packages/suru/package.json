{
  "name": "@suru-ui/suru",
  "version": "0.0.0",
  "license": "MIT",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/src",
    "dist/base.css",
    "dist/suru.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "default": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./text": {
      "default": "./dist/src/text/index.js",
      "types": "./dist/src/text/index.d.ts"
    },
    "./text/core": {
      "default": "./dist/src/text/core/index.js",
      "types": "./dist/src/text/core/index.d.ts"
    },
    "./theme": {
      "default": "./dist/src/theme/index.js",
      "types": "./dist/src/theme/index.d.ts"
    },
    "./base.css": "./dist/base.css",
    "./suru.css": "./dist/suru.css"
  },
  "dependencies": {
    "@suru-ui/slot": "^0.0.0",
    "@suru-ui/utils": "^0.0.0",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ladle/react": "^5.0.1",
    "@suru-ui/build": "^0.0.0",
    "@tailwindcss/vite": "^4.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.1"
  },
  "scripts": {
    "precheck": "node --experimental-strip-types ./theme/_gen.ts",
    "check": "tsc --noEmit",
    "test": "run-s test:*",
    "test:server": "vitest -c .config/vitest.server.ts --run src/",
    "test:client": "vitest -c .config/vitest.client.ts --run src/",
    "build": "run-s build:*",
    "build:gen": "node --experimental-strip-types ./theme/_gen.ts",
    "build:src": "sui-build --outDir=dist/src",
    "build:tsc": "tsc -p .config/tsconfig.build.json",
    "gen": "node --experimental-strip-types ./theme/_gen.ts",
    "dev": "ladle dev --config .config/ladle",
    "update": "ncu -u -x '@suru-ui/'*"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
