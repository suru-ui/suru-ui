{
  "name": "@suru-ui/suru",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./button": {
      "types": "./dist/src/button/index.d.ts",
      "default": "./dist/src/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/src/checkbox/index.d.ts",
      "default": "./dist/src/checkbox/index.js"
    },
    "./data-grid": {
      "types": "./dist/src/data-grid/index.d.ts",
      "default": "./dist/src/data-grid/index.js"
    },
    "./icon-button": {
      "types": "./dist/src/icon-button/index.d.ts",
      "default": "./dist/src/icon-button/index.js"
    },
    "./label": {
      "types": "./dist/src/label/index.d.ts",
      "default": "./dist/src/label/index.js"
    },
    "./select": {
      "types": "./dist/src/select/index.d.ts",
      "default": "./dist/src/select/index.js"
    },
    "./text": {
      "types": "./dist/src/text/index.d.ts",
      "default": "./dist/src/text/index.js"
    },
    "./text-input": {
      "types": "./dist/src/text-input/index.d.ts",
      "default": "./dist/src/text-input/index.js"
    },
    "./textarea": {
      "types": "./dist/src/textarea/index.d.ts",
      "default": "./dist/src/textarea/index.js"
    },
    "./theme": {
      "types": "./dist/src/theme/index.d.ts",
      "default": "./dist/src/theme/index.js"
    },
    "./unocss-vite": {
      "types": "./dist/src/unocss-vite/index.d.ts",
      "default": "./dist/src/unocss-vite/index.js"
    },
    "./suru.css": "./dist/src/suru.css",
    "./theme.css": "./dist/src/theme.css"
  },
  "scripts": {
    "update": "npm-check-updates --upgrade --target minor --reject '@suru-ui/'*",
    "gen": "bun run ./theme/gen/main.ts",
    "dev": "ladle dev --config .config/ladle",
    "test": "exit 0",
    "test:server": "vitest -c .config/vitest.server.ts --run tests/",
    "test:client": "vitest -c .config/vitest.client.ts --run tests/",
    "build": "run-s build:*",
    "build:gen": "bun run ./theme/gen/main.ts",
    "build:src": "sui-build --outDir=dist/src",
    "build:tsc": "tsc -p .config/tsconfig.build.json",
    "build:css": "node --experimental-strip-types ./scripts/build-css.ts"
  },
  "dependencies": {
    "@suru-ui/slot": "workspace:*",
    "@suru-ui/styled": "workspace:*",
    "clsx": "^2.1.1",
    "css.escape": "^1.5.1",
    "lucide-react": "^0.533.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ladle/react": "^5.0.3",
    "@suru-ui/build": "workspace:*",
    "@types/css.escape": "^1.5.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "dependency-tree": "^11.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "unocss": "^66.3.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
