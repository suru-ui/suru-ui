{
  "name": "@suru-ui/suru",
  "version": "0.0.0",
  "license": "MIT",
  "description": "",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@suru-ui/core": "workspace:*",
    "@suru-ui/slot": "workspace:*",
    "@suru-ui/styled": "workspace:*",
    "@suru-ui/utils": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.509.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@conform-to/react": "^1.5.0",
    "@conform-to/valibot": "^1.5.0",
    "@ladle/react": "^5.0.3",
    "@suru-ui/build": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unocss": "^66.1.1",
    "valibot": "^1.1.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "run-s test:*",
    "test:server": "vitest -c .config/vitest.server.ts --run src/",
    "test:client": "vitest -c .config/vitest.client.ts --run src/",
    "build": "run-s build:*",
    "build:src": "sui-build --outDir=dist/src",
    "build:tsc": "tsc -p .config/tsconfig.build.json",
    "gen": "node --experimental-strip-types ./theme/gen/main.ts",
    "dev": "ladle dev --config .config/ladle",
    "update": "ncu -u -x '@suru-ui/'*"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
