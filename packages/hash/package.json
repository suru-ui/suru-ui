  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "update": "npm-check-updates --upgrade --target minor --reject '@suru-ui/'*",
