{
  "name": "@suru-ui/react",
  "version": "0.0.0",
  "description": "",
  "homepage": "https://github.com/suru-ui/suru-ui",
  "license": "MIT",
  "author": "tai-kun",
  "repository": {
    "url": "https://github.com/suru-ui/suru-ui"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./button": {
      "types": "./dist/src/buttons/button/index.d.ts",
      "default": "./dist/src/buttons/button/index.js"
    },
    "./button-group": {
      "types": "./dist/src/buttons/button-group/index.d.ts",
      "default": "./dist/src/buttons/button-group/index.js"
    },
    "./toggle-button": {
      "types": "./dist/src/buttons/toggle-button/index.d.ts",
      "default": "./dist/src/buttons/toggle-button/index.js"
    },
    "./toggle-button-group": {
      "types": "./dist/src/buttons/toggle-button-group/index.d.ts",
      "default": "./dist/src/buttons/toggle-button-group/index.js"
    },
    "./checkbox": {
      "types": "./dist/src/forms/checkbox/index.d.ts",
      "default": "./dist/src/forms/checkbox/index.js"
    },
    "./checkbox-group": {
      "types": "./dist/src/forms/checkbox-group/index.d.ts",
      "default": "./dist/src/forms/checkbox-group/index.js"
    },
    "./input": {
      "types": "./dist/src/forms/input/index.d.ts",
      "default": "./dist/src/forms/input/index.js"
    },
    "./radio": {
      "types": "./dist/src/forms/radio/index.d.ts",
      "default": "./dist/src/forms/radio/index.js"
    },
    "./radio-group": {
      "types": "./dist/src/forms/radio-group/index.d.ts",
      "default": "./dist/src/forms/radio-group/index.js"
    },
    "./suru.css": "./dist/suru.css"
  },
  "scripts": {
    "build": "run-s build:*",
    "build:src": "tsc --project ./.config/tsconfig.build.json",
    "build:css": "node ./scripts/build-css.ts",
    "build:dst": "node ./scripts/comment-out-css-imports.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@base-ui/utils": "^0.3.1",
    "@suru-ui/core": "workspace:*",
    "@suru-ui/theme": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-themes": "^10.5.4",
    "@storybook/addon-vitest": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "dependency-tree": "^12.0.1",
    "lucide-react": "^1.27.0",
    "npm-check-updates": "^22.2.9",
    "npm-run-all2": "^9.0.2",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.4",
    "unocss": "^66.7.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
