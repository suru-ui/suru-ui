{
  "extends": ["@tsconfig/strictest"],
  "include": [
    "./global.d.ts",
    "../src/**/*.client.test.ts",
    "../src/**/*.client.test.tsx",
    "../tests/**/*.client.test.ts",
    "../tests/**/*.client.test.tsx"
  ],
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["DOM", "ESNext"],
    "jsx": "preserve",
    "noEmit": true,
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true
  }
}
