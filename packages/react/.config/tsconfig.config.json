{
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "include": ["./**/*"],
  "exclude": ["./global.d.ts", "./_reset-pointer.ts"],
  "compilerOptions": {
    "types": ["node", "vite/client"],
