{
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "include": [
    "./global.d.ts",
    "../src/**/*.server.test.ts",
    "../src/**/*.server.test.tsx",
    "../tests/**/*.server.test.ts",
    "../tests/**/*.server.test.tsx"
  ],
  "compilerOptions": {
    "types": ["node", "vite-plus/client"],
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "noEmit": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "erasableSyntaxOnly": true
  }
}
