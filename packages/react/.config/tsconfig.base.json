{
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "include": ["./global.d.ts", "../scripts/**/*", "../src/**/*"],
  "exclude": ["../src/**/*.stories.tsx", "../src/**/*.test.ts", "../src/**/*.test.tsx"],
  "compilerOptions": {
    "types": ["node", "vite-plus/client", "vite-plus/test/matchers"],
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "noEmit": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "erasableSyntaxOnly": true
  }
}
