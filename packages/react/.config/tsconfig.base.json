{
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "include": ["./global.d.ts", "../scripts/**/*", "../src/**/*"],
  "exclude": ["../src/**/*.stories.tsx", "../src/**/*.test.ts", "../src/**/*.test.tsx"],
  "compilerOptions": {
    "types": ["node"],
    "lib": ["DOM", "ESNext"],
    "jsx": "preserve",
    "noEmit": true,
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true
  }
}
