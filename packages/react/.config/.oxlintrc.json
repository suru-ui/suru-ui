{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "oxc",
    "import",
    "jsdoc",
    "jsx-a11y",
    "node",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/namespace": "off", // `export * from "./*.jsx"` を解決できないため無効化
    "no-unused-expressions": "off", // logtape で使用します。
    "no-unused-vars": "warn", // TypeScript に委譲します。
    "vitest/no-focused-tests": "off", // デバッグ作業を容易にします。
    "typescript/no-duplicate-type-constituents": "off", // 形式的に必要な処理を残します。
    "typescript/no-redundant-type-constituents": "off", // 形式的に必要な処理を残します。
    "react/no-children-prop": "off", // 一時的に無効化
    "jsx_a11y/label-has-associated-control": "off" // 一時的に無効化
  },
  "env": {
    "builtin": true
  },
  "options": {
    "typeAware": true
  }
}
