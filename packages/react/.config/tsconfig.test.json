{
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "include": [
    "./global.d.ts",
    "../src/**/*.stories.tsx",
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx",
    "../tests/**/*"
  ],
  "exclude": [
    "../src/**/*.client.test.ts",
    "../src/**/*.client.test.tsx",
    "../src/**/*.server.test.ts",
    "../src/**/*.server.test.tsx",
    "../tests/**/*.client.test.ts",
    "../tests/**/*.client.test.tsx",
    "../tests/**/*.server.test.ts",
    "../tests/**/*.server.test.tsx"
  ],
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "lib": ["DOM", "ESNext"],
    "jsx": "preserve",
    "noEmit": true,
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true
  }
}
