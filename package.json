{
  "name": "suru-ui",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/build",
    "packages/hash",
    "packages/cssinjs",
    "packages/utils",
    "packages/slot",
    "packages/styled",
    "packages/core",
    "packages/suru"
  ],
  "scripts": {
    "check": "run-s check:*",
    "precheck": "dprint check",
    "check:build": "  npm run check -w packages/build  ",
    "check:hash": "   npm run check -w packages/hash   ",
    "check:cssinjs": "npm run check -w packages/cssinjs",
    "check:utils": "  npm run check -w packages/utils  ",
    "check:slot": "   npm run check -w packages/slot   ",
    "check:styled": " npm run check -w packages/styled ",
    "check:core": "   npm run check -w packages/core   ",
    "check:suru": "   npm run check -w packages/suru   ",
    "test": "run-s test:*",
    "test:build": "  npm run test -w packages/build  ",
    "test:hash": "   npm run test -w packages/hash   ",
    "test:cssinjs": "npm run test -w packages/cssinjs",
    "test:utils": "  npm run test -w packages/utils  ",
    "test:slot": "   npm run test -w packages/slot   ",
    "test:styled": " npm run test -w packages/styled ",
    "test:core": "   npm run test -w packages/core   ",
    "test:suru": "   npm run test -w packages/suru   ",
    "build": "run-s build:*",
    "prebuild": "     npm run build -w packages/build && bun i",
    "build:hash": "   npm run build -w packages/hash          ",
    "build:cssinjs": "npm run build -w packages/cssinjs       ",
    "build:utils": "  npm run build -w packages/utils         ",
    "build:slot": "   npm run build -w packages/slot          ",
    "build:styled": " npm run build -w packages/styled        ",
    "build:core": "   npm run build -w packages/core          ",
    "build:suru": "   npm run build -w packages/suru          ",
    "gen:suru": "npm run gen -w packages/suru",
    "dev:core": "npm run dev -w packages/core",
    "dev:suru": "npm run dev -w packages/suru",
    "update": "run-s update:*",
    "update:monorepo": "ncu -u                        ",
    "update:packages": "npm run update -ws            ",
    "update:dprint": "  dprint config update          ",
    "update:install": " bun i                         ",
    "update:deps": "    playwright install --with-deps",
    "ci": "run-s ci:*",
    "ci:test": "act -W .github/workflows/ci.yml -j test",
    "clean": "bun run scripts/clean.ts"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.15.30",
    "@vitest/browser": "^3.2.2",
    "dprint": "^0.50.0",
    "npm-check-updates": "^18.0.1",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.52.0",
    "stylelint": "^16.20.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-recess-order": "^6.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "volta": {
    "node": "22.16.0"
  }
}
