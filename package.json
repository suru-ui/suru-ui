{
  "name": "suru-ui",
  "type": "module",
  "private": true,
  "workspaces": [],
  "scripts": {
    "update": "run-s update:*",
    "update:nodejs": "volta pin node@lts",
    "update:module": "run-s update:module:*",
    "update:module:monorepo": "npm-check-updates --target minor -u",
    "update:module:packages": "npm run -ws update",
    "update:dprint": "dprint config update",
    "update:playwright": "playwright install chromium --with-deps"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.16.5",
    "@vitest/browser": "^3.2.4",
    "dprint": "^0.50.1",
    "npm-check-updates": "^18.0.2",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.54.1",
    "stylelint": "^16.22.0",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "volta": {
    "node": "22.17.1"
  }
}
