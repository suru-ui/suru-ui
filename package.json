{
  "name": "suru-ui",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/build",
    "packages/hash",
    "packages/cssinjs",
    "packages/utils",
    "packages/slot",
    "packages/styled",
    "packages/suru"
  ],
  "scripts": {
    "check": "npm run check -ws",
    "precheck": "dprint check",
    "check:build": "  npm run check -w packages/build  ",
    "check:cssinjs": "npm run check -w packages/cssinjs",
    "check:hash": "   npm run check -w packages/hash   ",
    "check:slot": "   npm run check -w packages/slot   ",
    "check:styled": " npm run check -w packages/styled ",
    "check:suru": "   npm run check -w packages/suru   ",
    "check:utils": "  npm run check -w packages/utils  ",
    "test": "npm run test -ws",
    "test:build": "  npm run test -w packages/build  ",
    "test:cssinjs": "npm run test -w packages/cssinjs",
    "test:hash": "   npm run test -w packages/hash   ",
    "test:slot": "   npm run test -w packages/slot   ",
    "test:styled": " npm run test -w packages/styled ",
    "test:suru": "   npm run test -w packages/suru   ",
    "test:utils": "  npm run test -w packages/utils  ",
    "build": "npm run build -ws",
    "build:build": "  npm run build -w packages/build  ",
    "build:cssinjs": "npm run build -w packages/cssinjs",
    "build:hash": "   npm run build -w packages/hash   ",
    "build:slot": "   npm run build -w packages/slot   ",
    "build:styled": " npm run build -w packages/styled ",
    "build:suru": "   npm run build -w packages/suru   ",
    "build:utils": "  npm run build -w packages/utils  ",
    "gen": "npm run gen -w packages/suru",
    "dev": "npm run dev -w packages/suru"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.10.7",
    "@vitest/browser": "^3.0.2",
    "dprint": "^0.48.0",
    "npm-run-all2": "^7.0.2",
    "playwright": "^1.49.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "volta": {
    "node": "22.13.0"
  }
}
