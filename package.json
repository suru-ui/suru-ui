{
  "name": "suru-ui",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/build",
    "packages/hash",
    "packages/css",
    "packages/slot",
    "packages/styled",
    "packages/suru"
  ],
  "scripts": {
    "update": "run-s update:*",
    "update:nodejs": "volta pin node@lts",
    "update:module": "run-s update:module:*",
    "update:module:monorepo": "npm-check-updates --upgrade --target minor",
    "update:module:packages": "npm run -ws update",
    "update:dprint": "dprint config update",
    "update:playwright": "playwright install chromium --with-deps",
    "gen:suru": "npm run gen -w packages/suru",
    "dev:suru": "npm run dev -w packages/suru",
    "test": "run-s test:*",
    "test:build": " npm run test -w packages/build ",
    "test:hash": "  npm run test -w packages/hash  ",
    "test:css": "   npm run test -w packages/css   ",
    "test:slot": "  npm run test -w packages/slot  ",
    "test:styled": "npm run test -w packages/styled",
    "test:suru": "  npm run test -w packages/suru  ",
    "build": "run-s build:*",
    "build:build": " npm run build -w packages/build ",
    "build:hash": "  npm run build -w packages/hash  ",
    "build:css": "   npm run build -w packages/css   ",
    "build:slot": "  npm run build -w packages/slot  ",
    "build:styled": "npm run build -w packages/styled",
    "build:suru": "  npm run build -w packages/suru  "
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.16.5",
    "@vitest/browser": "^3.2.4",
    "dprint": "^0.50.1",
    "npm-check-updates": "^18.0.2",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.54.1",
    "stylelint": "^16.22.0",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vitest-browser-react": "^1.0.1"
  },
  "volta": {
    "node": "22.17.1"
  }
}
