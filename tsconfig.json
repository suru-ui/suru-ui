{
  "extends": [
    "@tsconfig/node22",
    "@tsconfig/strictest"
  ],
  "compilerOptions": {
    "types": [
      "node",
      "vite/client",
      "@vitest/browser/providers/playwright"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ESNext"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "erasableSyntaxOnly": true
  }
}
