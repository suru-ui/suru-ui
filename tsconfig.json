{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "include": [
    "./packages/**/*",
    "./env.d.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ],
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  }
}
